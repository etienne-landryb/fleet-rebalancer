# Copy to .env and fill in. NEVER commit .env.

# --- Supabase (Frankfurt / eu-central) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# --- LLM (Groq, free tier) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- GBFS ---
GBFS_PRIMARY_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
GBFS_PRIMARY_SYSTEM_ID=citi-bike-nyc

# --- BigQuery ---
# For public datasets you can use a service account or `gcloud auth application-default login`.
# Set this to the path to your service-account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=

# --- Weather (optional; Open-Meteo needs no key) ---
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Runtime ---
FORECAST_HORIZON_MIN=45
IMBALANCE_THRESHOLD=0.30
MAX_REPLAN=3
# Server-side fallbacks (UI defaults: VAN_COUNT=3, VAN_CAPACITY=25)
VAN_COUNT=2
VAN_CAPACITY=20
SHIFT_BUDGET_MIN=120
PG_WINDOW_HOURS=72
